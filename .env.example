# Is file ko ".env" naam se copy karein aur values bharein. .env kabhi git mein na daalein.

# ---- Django ----
DJANGO_DEBUG=false
# Naya key banane ke liye:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=inspect.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://inspect.example.com

# HTTPS proxy (Nginx/IIS) ke peeche true rakhein. Sirf HTTP par test karna ho to false.
DJANGO_SECURE_SSL_REDIRECT=true
# Pehle din chhota rakhein (e.g. 3600), sab theek chale to 2592000 (30 din)
DJANGO_HSTS_SECONDS=3600

# Windows + Waitress (bina IIS media ke) par true; Linux + Nginx par false
DJANGO_SERVE_MEDIA=false

# ---- PostgreSQL (khali chhorein to SQLite) ----
POSTGRES_DB=autoinspect
POSTGRES_USER=autoinspect
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- AI model ----
# DAMAGE_MODEL_PATH=/srv/autoinspect/ml_models/car_damage_yolo11-seg.pt
# DAMAGE_MODEL_CONF=0.35
